# EmailJS Configuration
# Get these values from https://www.emailjs.com/

# Your EmailJS Public Key (from Account → API Keys)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your Email Service ID (from Email Services)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here

# Your Email Template ID (from Email Templates)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here

# Example with real-looking values:
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=abc123def456ghi789jkl012mno345
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_abc123def456ghi789
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xyz789abc123def456
